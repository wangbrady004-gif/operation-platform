{
  "name": "ops-platform-standalone",
  "private": true,
  "scripts": {
    "start": "concurrently --kill-others-on-fail --pad-prefix --names \"API,WEB\" --prefix-colors \"blueBright,greenBright\" \"npm run api\" \"npm run web\"",
    "api": "npm --prefix apps/api run start:dev",
    "web": "npm --prefix apps/web run dev:webpack",
    "install:all": "npm --prefix apps/api install && npm --prefix apps/web install"
  },
  "devDependencies": {
    "concurrently": "^9.1.2",
    "wait-on": "^9.0.10"
  }
}
