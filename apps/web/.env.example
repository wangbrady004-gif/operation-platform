# URL of the NestJS API (server-side fetches from Next.js App Router)
OPS_API_URL=http://127.0.0.1:8899

# Build server — generates launcher EXEs and merchant bot EXEs
BUILD_SERVER_URL=https://build.ultrapay.live
BUILD_API_KEY=your_build_api_key_here

# Shared secret for ops launcher EXEs — must match LAUNCHER_KEY in apps/api/.env
LAUNCHER_KEY=change-me-long-random-launcher-secret
