# Browser-accessible URL for server-side fetches from Next.js (App Router).
OPS_API_URL=http://127.0.0.1:8899

# Optional: override merchant business portal (no trailing slash). Default is Paytm business.
# NEXT_PUBLIC_MERCHANT_PORTAL_ORIGIN=https://example.com

# Build server for Generate EXE / Generate Launcher pages
NEXT_PUBLIC_BUILD_SERVER_URL=https://build.ultrapay.live
NEXT_PUBLIC_BUILD_API_KEY=your_api_key_here
