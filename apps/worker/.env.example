# Copy this file to:  apps/worker/.env   (recommended when you `cd apps/worker`)
#
# Alternative: apps/worker/worker/.env  (already supported)
#
# Without any .env file, you must export the same vars in your shell instead.

OPS_API_URL=http://127.0.0.1:8899
INTERNAL_API_TOKEN=change-me-same-as-apps-api-env

# Optional: explicit bot tree (otherwise worker searches upward for integrations/b_auto_bot)
# B_AUTO_REPO_ROOT=/absolute/path/to/ops-platform-standalone/integrations/b_auto_bot
