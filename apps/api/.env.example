PORT=8899

# PostgreSQL (run: docker compose -f ../../docker-compose.yml up -d)
DATABASE_URL=postgresql://ops:ops@127.0.0.1:5432/ops

# JWT for operator UI (Next.js stores token in httpOnly cookie after /login)
JWT_SECRET=change-me-use-long-random-string

# First admin when users table is empty
INIT_ADMIN_EMAIL=admin@localhost
INIT_ADMIN_PASSWORD=change-me-8-chars-min

# Shared secret between API and Python worker (required for /internal/* routes)
INTERNAL_API_TOKEN=change-me-dev-token

# AES-256-GCM key material for PayTM merchant password / txn_pass at rest (≥16 chars)
MERCHANT_ENCRYPTION_KEY=change-me-long-random-phrase-for-merchant-secrets
